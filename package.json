{
  "name": "react-native-intl-phone",
  "version": "0.1.0",
  "description": "International phone number input for React Native with country picker, as-you-type formatting and validation powered by libphonenumber-js",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "sideEffects": false,
  "scripts": {
    "example": "yarn workspace react-native-intl-phone-example",
    "build": "bob build",
    "clean": "rm -rf lib",
    "typecheck": "tsc",
    "test": "jest",
    "prepare": "bob build",
    "prepublishOnly": "yarn typecheck && yarn test"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "web",
    "phone",
    "phone-input",
    "phone-number",
    "international",
    "country-picker",
    "libphonenumber"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tadeumelembe/react-native-international-phone-input.git"
  },
  "author": "Tadeu Melembe <tadeumelembe@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tadeumelembe/react-native-international-phone-input/issues"
  },
  "homepage": "https://github.com/tadeumelembe/react-native-international-phone-input#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "libphonenumber-js": "^1.11.3"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-native": "*"
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.86.3",
    "@react-native/jest-preset": "0.86.3",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.2.4",
    "jest": "^29.2.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-builder-bob": "^0.43.1",
    "typescript": "~6.0.3"
  },
  "workspaces": [
    "example"
  ],
  "jest": {
    "preset": "@react-native/jest-preset",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "packageManager": "yarn@4.18.1"
}
